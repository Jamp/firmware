#!/bin/sh
#
# divinus streams only once the camera has an owner: root has a password and
# so do the streams. Until then it stays down and says how to set it up.
#
# Its log goes to syslog: /tmp is RAM and divinus logs every request.
#
# The watchdog in divinus.yaml covers a hung divinus, but this SoC's driver
# disarms when the device is closed, so it does nothing if divinus dies. A
# crash can also leave SDK memory reserved until the next boot, which starves
# the encoder: when divinus exits without being stopped here, reboot. Not in
# the first minutes after boot, so a divinus that cannot start does not loop
# the camera and SSH stays reachable to fix it.

CONF=/etc/divinus.yaml
STOPPED=/var/run/divinus.stopped
SUPERVISOR=/var/run/divinus.supervisor

claimed() {
	[ -n "$(awk -F: '$1 == "root" { print $2; exit }' /etc/shadow 2>/dev/null)" ] &&
		[ -n "$(yaml-cli -i "$CONF" -g .rtsp.auth_pass 2>/dev/null)" ]
}

supervise() {
	echo $$ > "$SUPERVISOR"
	# Started from an SSH session, the shell would report a crash on the closed
	# session and die of SIGPIPE before it could reboot
	exec < /dev/null > /dev/null 2>&1
	/usr/bin/divinus 2>&1 | logger -t divinus
	[ -e "$STOPPED" ] && exit
	if [ "$(cut -d. -f1 /proc/uptime)" -lt 180 ]; then
		logger -t divinus "exited right after boot, not streaming"
	else
		logger -t divinus "exited unexpectedly, rebooting"
		reboot
	fi
}

start() {
	if ! claimed; then
		echo "divinus: not set up, log in as root and run divinus-passwd"
		logger -t divinus "not set up, not streaming"
		return 0
	fi
	echo -n "Starting divinus: "
	rm -f "$STOPPED"
	# musl only honours the zone set in /etc/TZ through the environment
	export TZ=$(cat /etc/TZ 2>/dev/null)
	# In a session of its own: restarted from "ssh -t" (divinus-passwd), closing
	# the session kills what is still in it, divinus and this supervisor too.
	# Return only once the supervisor is out, or logout can beat setsid.
	rm -f "$SUPERVISOR"
	setsid "$0" supervise &
	n=0
	while [ ! -e "$SUPERVISOR" ] && [ "$n" -lt 50 ]; do
		sleep 0.1
		n=$((n + 1))
	done
	echo "OK"
}

stop() {
	echo -n "Stopping divinus: "
	touch "$STOPPED"
	killall -q divinus
	# The SDK allows one client: wait until it has let go of the hardware
	n=0
	while pidof divinus > /dev/null && [ "$n" -lt 10 ]; do
		sleep 1
		n=$((n + 1))
	done
	echo "OK"
}

case "$1" in
	start)
		start
		;;

	stop)
		stop
		;;

	restart)
		stop
		start
		;;

	supervise)
		supervise
		;;

	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
